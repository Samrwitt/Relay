{
  "name": "relay",
  "version": "1.0.0",
  "description": "Open a link on two devices and transfer huge files directly between them.",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "start:native": "RELAY_HTTP=1 node server/index.js",
    "native:config": "node scripts/write-native-config.js",
    "cap:sync": "node scripts/write-native-config.js && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:add:android": "npx cap add android"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.1"
  }
}
